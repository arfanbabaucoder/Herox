#include <behaviors.dtsi>
#include <dt-bindings/herox/feature.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        nx_encoder_feature: nx_encoder_feature {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&nx_feature>, <&nx_feature>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Herox";
            bindings = <
                &kp ESC &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12 &kp PSCRN &kp SLCK &kp PAUSE_BREAK
                &kp GRAVE &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS &kp EQUAL &kp BSPC &kp INS &kp HOME &kp PG_UP &kp KP_NUM &kp KP_DIVIDE &kp KP_MULTIPLY &kp KP_MINUS
                &kp TAB &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp LBKT &kp RBKT &kp BSLH &kp DEL &kp END &kp PG_DN &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp KP_PLUS
                &kp CAPS &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp SEMI &kp SQT &kp RET &kp KP_N4 &kp KP_N5 &kp KP_N6
                &kp LSHFT &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp RSHFT &kp UP &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_ENTER
                &kp LCTRL &kp LGUI &kp LALT &kp SPACE &kp RALT &kp RGUI &lt 1 K_APP &kp RCTRL &kp LEFT &kp DOWN &kp RIGHT &kp KP_N0 &kp KP_DOT
                &kp C_MUTE
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        function_layer {
            display-name = "Control";
            bindings = <
                &bootloader &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_CLR &out OUT_USB &out OUT_BLE &out OUT_TOG &nx_feature NX_RGB_EFFECT_PREVIOUS &nx_feature NX_RGB_EFFECT_NEXT &nx_feature NX_RGB_BRIGHTNESS_DOWN &nx_feature NX_RGB_BRIGHTNESS_UP &nx_feature NX_RGB_TOGGLE &studio_unlock &soft_off &sys_reset
                &nx_feature NX_HAPTIC_TOGGLE &nx_feature NX_HAPTIC_DOWN &nx_feature NX_HAPTIC_UP &nx_feature NX_HAPTIC_TEST &trans &trans &trans &trans &trans &trans &trans &nx_feature NX_RGB_HUE_DOWN &nx_feature NX_RGB_HUE_UP &trans &trans &trans &trans &trans &nx_feature NX_RGB_HUE_DOWN &nx_feature NX_RGB_HUE_UP &nx_feature NX_RGB_SPEED_DOWN
                &trans &kp C_PREV &kp C_PP &kp C_NEXT &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &nx_feature NX_RGB_EFFECT_PREVIOUS &nx_feature NX_RGB_TOGGLE &nx_feature NX_RGB_EFFECT_NEXT &nx_feature NX_RGB_BRIGHTNESS_UP
                &trans &kp C_VOL_DN &kp C_MUTE &kp C_VOL_UP &trans &trans &trans &trans &trans &trans &trans &trans &trans &nx_feature NX_RGB_SPEED_DOWN &nx_feature NX_HAPTIC_TOGGLE &nx_feature NX_RGB_SPEED_UP
                &trans &kp LC(Z) &kp LC(X) &kp LC(C) &kp LC(V) &trans &trans &trans &trans &trans &trans &trans &mmv MOVE_UP &nx_feature NX_RGB_BRIGHTNESS_DOWN &nx_feature NX_RGB_TOGGLE &nx_feature NX_RGB_BRIGHTNESS_UP &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &msc SCRL_DOWN &mkp LCLK
                &nx_feature NX_HAPTIC_TEST
            >;
            sensor-bindings = <&nx_encoder_feature NX_RGB_BRIGHTNESS_UP NX_RGB_BRIGHTNESS_DOWN>;
        };

        studio_layer_1 {
            status = "reserved";
        };

        studio_layer_2 {
            status = "reserved";
        };

        studio_layer_3 {
            status = "reserved";
        };
    };
};
